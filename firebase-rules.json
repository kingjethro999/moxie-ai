{
  "rules": {
    "chats": {
      ".indexOn": ["userId", "updatedAt"],
      "$chatId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && data.child('userId').val() === auth.uid"
      }
    },
    "messages": {
      ".indexOn": ["createdAt"],
      "$chatId": {
        ".read": "auth != null && root.child('chats/' + $chatId + '/userId').val() === auth.uid",
        ".write": "auth != null && root.child('chats/' + $chatId + '/userId').val() === auth.uid"
      }
    },
    "api_keys": {
      "$key": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && data.child('userId').val() === auth.uid"
      }
    }
  }
}
